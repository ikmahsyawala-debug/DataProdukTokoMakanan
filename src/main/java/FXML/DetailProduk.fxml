<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane"
            prefHeight="567.0"
            prefWidth="366.0"
            stylesheets="@../Css/Style.css"
            xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/21"
            fx:controller="Controller.DetailProdukController">

    <children>

        <Button fx:id="btnLihatProduk"
                layoutX="151.0"
                layoutY="29.0"
                mnemonicParsing="false"
                prefHeight="33.0"
                prefWidth="91.0"
                style="-fx-border-color: #000;"
                text="Lihat Produk" />

        <VBox layoutX="38.0"
              layoutY="80.0"
              prefHeight="454.0"
              prefWidth="290.0"
              style="-fx-background-color: #ffdab9; -fx-spacing: 50; -fx-padding: 24;">

            <children>

                <Label fx:id="lblKode" text="Kode" />

                <Label fx:id="lblNama" text="Nama" />

                <Label fx:id="lblKategori" text="Kategori" />

                <Label fx:id="lblHarga" text="Harga" />

                <Button fx:id="btnTambahProduk"
                        mnemonicParsing="false"
                        prefHeight="25.0"
                        prefWidth="245.0"
                        style="-fx-border-color: #000; -fx-background-color: #ffe4e1;"
                        text="Tambah Produk" />

            </children>
        </VBox>

        <Label layoutX="38.0"
               layoutY="35.0"
               style="-fx-font-size: 18;"
               text="Detail Produk">

            <font>
                <Font size="18.0" />
            </font>

        </Label>

    </children>
</AnchorPane>