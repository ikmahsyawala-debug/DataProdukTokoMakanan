            <TextField fx:id="txtHargaProduk" />
            <Button fx:id="btnsimpan" mnemonicParsing="false" prefHeight="25.0" prefWidth="243.0" style="-fx-background-color: #ffe4e1;" text="Simpan dan Lihat Produk" />
