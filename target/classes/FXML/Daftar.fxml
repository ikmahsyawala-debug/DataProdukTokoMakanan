<AnchorPane id="AnchorPane" prefHeight="523.0" prefWidth="374.0" style="-fx-background-color: #ffe4e1;" stylesheets="@../Css/Style.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.DaftarController">
