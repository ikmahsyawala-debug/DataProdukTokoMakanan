      <Label layoutX="24.0" layoutY="14.0" text="Tambah Produk">
         <font>
            <Font name="Sans Serif Collection" size="12.0" />
         </font></Label>
      <Button fx:id="btnLihatProduk" layoutX="121.0" layoutY="19.0" mnemonicParsing="false" style="-fx-background-color: #fadadd; -fx-border-color: #000;" text="Lihat Produk" />
      <VBox layoutX="40.0" layoutY="77.0" prefHeight="340.0" prefWidth="285.0" style="-fx-background-color: #ffdab9; -fx-padding: 24; -fx-background-radius: 14; -fx-spacing: 12;">
         <children>
            <Label text="Tambah Produk" />
            <Label text="Nama Produk" />
            <TextField fx:id="txtNamaProduk" />
